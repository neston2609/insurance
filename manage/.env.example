HOST=127.0.0.1
PORT=3001
# Optional Vite proxy override when PORT is changed.
API_PROXY_TARGET=http://127.0.0.1:3001
APP_SECRET=replace-with-a-persistent-random-32-byte-value
SESSION_SECRET=replace-with-a-different-random-32-byte-value
ADMIN_USERNAME=admin
# Bootstrap only; remove after the first successful start.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Required for POST /api/public/call-back-results. Use HTTPS and a unique secret.
CALLBACK_API_USERNAME=replace-with-a-unique-api-username
CALLBACK_API_PASSWORD=replace-with-a-long-unique-api-password
