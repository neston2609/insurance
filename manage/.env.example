HOST=127.0.0.1
PORT=3001
# Optional Vite proxy override when PORT is changed.
API_PROXY_TARGET=http://127.0.0.1:3001
APP_SECRET=replace-with-a-persistent-random-32-byte-value
SESSION_SECRET=replace-with-a-different-random-32-byte-value
ADMIN_USERNAME=admin
# Bootstrap only; remove after the first successful start.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional Genesys Cloud scheduled-callback integration (AP Southeast 2 example).
# When configured, all four Genesys values below are required.
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=
GENESYS_CALLBACK_QUEUE_ID=
# Optional duplicate-protection window, milliseconds (default: 300000 / 5 minutes).
GENESYS_CALLBACK_DUPLICATE_WINDOW_MS=300000
